[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=FiatLux
Exec=FiatLux
Name=fiat lux
Comment=Light meter for film photography

# Sandboxing, deliberately commented out while sideloading.
#
# An unsandboxed app gets hardware access without declaring anything. A
# sandboxed one gets exactly what it declares -- and this block, with an EMPTY
# Permissions line, declared nothing. Launched from the app grid the launcher
# applied the sandbox and granted no camera and no sensors. Launched from Qt
# Creator after a deploy, or by running /usr/bin/FiatLux over SSH, sailjail is
# bypassed entirely. That is the whole reason the camera "worked right after
# deploy" and never from the menu.
#
# Before submitting to Chum or the Jolla Store this comes back, with the real
# permission names checked against /etc/sailjail/permissions/ on the device,
# and Exec becomes:
#   Exec=sailjail -p harbour-fiatlux.desktop /usr/bin/harbour-fiatlux
#
#[X-Sailjail]
#OrganizationName=se.munkstolen
#ApplicationName=harbour-fiatlux
#Permissions=Camera;Pictures;Sensors;
